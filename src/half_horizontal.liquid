{%- comment -%}
  half_horizontal.liquid

  The outermost element carries "iss" alongside the framework's view classes.
  That class is what every selector in shared.liquid hangs off, so it must not
  be renamed without updating the namespace passed to the linter.

  Paste the real half_horizontal markup below, keeping the .iss class on the root and
  prefixing any new class with iss-.
{%- endcomment -%}

{% include "shared" %}

<div class="view view--half_horizontal iss">
  <div class="layout">
    <div class="iss-map">
      <div class="iss-map__station" style="left: {{ iss_x }}%; top: {{ iss_y }}%;"></div>
    </div>
    <div class="iss-facts">
      <span class="label">{{ iss_location }}</span>
      <span class="value value--xsmall">{{ iss_altitude }}</span>
    </div>
  </div>
  <div class="title_bar">
    <span class="title">ISS Tracker Map</span>
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
  </div>
</div>

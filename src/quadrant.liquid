{%- comment -%}
  quadrant.liquid — ISS Tracker Map (compact view)

  This is the view a 2x2 / 4-up mashup renders.

  SCOPING CONTRACT
  ----------------
  A mashup renders every plugin into one document. There is no iframe and no
  shadow root, so this style block is a document-wide stylesheet and this
  script can see every other plugin's DOM.

  The framework ships entirely inside @layer while a plugin's <style> block is
  unlayered, and unlayered CSS beats layered CSS regardless of specificity. A
  bare `*` here would outrank even the framework's own multi-class rules, so
  scope is the only thing holding these styles in.

  STYLING
  -------
  Chrome is framework utilities in the markup (absolute, bottom--2, bg--white,
  rounded--medium, p--2, flex, value, label). Only what the framework has no
  utility for is left below. Notably the typography is now the framework's:
  TRMNL16 is a pixel font built for 1-bit e-ink, where the previous
  system-ui override was antialiased for LCD.

  Identical in content to half_vertical.liquid. Change both together.
{%- endcomment -%}

<style>
  /* Positioning context for the absolutely-placed map overlays. */
  .iss{ position:relative; }

  /* Leaflet's container and the handful of its rules this plugin relies on.
     Renamed from .map, which is the framework's own map component. */
  .iss .iss-map{ height:100%; width:100%; }
  .iss .iss-map.leaflet-container{ position:relative; overflow:hidden; background:#ddd; outline:0; }
  .iss .leaflet-pane{ position:absolute; left:0; top:0; }
  .iss .leaflet-tile{ position:absolute; left:0; top:0; width:256px; height:256px; }
  .iss .leaflet-zoom-animated{ transform-origin:0 0; }
  .iss .leaflet-zoom-hide{ visibility:hidden; }
  .iss .leaflet-control-attribution{ display:none; }

  /* Centred on the map. There is no utility for translate-based centring. */
  .iss .iss-craft{ top:50%; left:50%; transform:translate(-50%,-50%); }
  .iss .iss-craft img{ width:48px; height:48px; filter:brightness(0); }

  /* border--h-* and border--v-* are single-edge pseudo-elements, so a box
     border is still custom. min-height keeps the pill stable when the fitted
     text is short. */
  .iss .iss-pill{ border:1.5px solid #000; min-height:40px; }

  /* No truncation utility. */
  .iss .iss-text{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  /* Event text wraps instead of truncating, and is upper-cased: .label leaves
     text-transform at none unless the theme sets it. */
  .iss .iss-text--event{ white-space:normal; text-transform:uppercase; }
</style>

<div class="layout iss">
  <div class="iss-map"></div>
  <div class="iss-craft absolute z--2"><img class="iss-icon" alt="ISS" src="" /></div>

  <div class="iss-pill absolute bottom--2 left--2 right--2 z--3 bg--white rounded--medium p--2 flex flex--center">
    <div class="iss-text value value--xxsmall text--center w--full">Loading...</div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(() => {
  // --- 0. THIS INSTANCE'S ROOT ---
  // Every lookup goes through ROOT. document.getElementById would find the
  // first match in the mashup, which is another plugin's or this plugin's
  // other instance, never reliably this one.
  const SELF = document.currentScript;
  const ROOT =
    (SELF && SELF.closest('.iss')) ||
    (SELF && SELF.parentElement && SELF.parentElement.querySelector('.iss')) ||
    document.querySelector('.iss');
  if (!ROOT) return;
  const $ = (sel) => ROOT.querySelector(sel);

  // Mode is expressed by swapping framework utility classes rather than by a
  // custom rule per state.
  const MODES = {
    LOCATION: { pill: ['bg--white'], text: ['text--center'] },
    EVENT:    { pill: ['bg--black'], text: ['text--left', 'text--white', 'iss-text--event'] }
  };

  function applyMode(pill, text, mode) {
    for (const [name, sets] of Object.entries(MODES)) {
      const on = name === mode;
      for (const c of sets.pill) pill.classList.toggle(c, on);
      for (const c of sets.text) text.classList.toggle(c, on);
    }
  }

  // --- 1. CONSTANTS & CONFIG ---
  const CONFIG = {
    enableRotation: "{{ trmnl.plugin_settings.custom_fields_values.random_rotation | default: 'true' }}" !== 'false',
    urls: {
      iss: "https://raw.githubusercontent.com/nikokoren/mission_control/refs/heads/main/rockets/iss.png",
      eva: "https://raw.githubusercontent.com/nikokoren/mission_control/refs/heads/main/rockets/iss_eva.png"
    }
  };

  // --- 2. INPUT DATA (Raw) ---
  const firstNonEmpty = (...xs) => { for (const x of xs){ const s=String(x??'').trim(); if(s) return s; } return ''; };
  const RAW_DATA = {
    lat: firstNonEmpty('{{ lat }}', '{{ IDX_0.lat }}'),
    lon: firstNonEmpty('{{ lon }}', '{{ IDX_0.lon }}'),
    place: firstNonEmpty('{{ place }}', '{{ IDX_0.place }}'),
    short_info: '{% if trmnl.plugin_settings.custom_fields_values.show_iss_events == "true" %}{{ special_event.short_info | default: "" }}{% endif %}',
    event_type: '{{ special_event.type | default: "" }}'
  };

  // --- 3. THE BRAIN (Shared Logic) ---
  function computeState(raw, cfg) {
    const lat = Number(raw.lat);
    const lon = Number(raw.lon);
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;

    const info = raw.short_info.trim();
    const hasActiveEvent = info.length > 0;
    const isEVA = raw.event_type.trim() === "EVA" && hasActiveEvent;

    return {
      isValid: true,
      map: { lat, lon },
      icon: {
        url: isEVA ? cfg.urls.eva : cfg.urls.iss,
        rotation: cfg.enableRotation ? Math.floor(Math.random() * 360) : 0
      },
      pill: {
        mode: hasActiveEvent ? 'EVENT' : 'LOCATION',
        text: hasActiveEvent ? info : ((raw.place || '').trim() || `${lat.toFixed(2)}°, ${lon.toFixed(2)}°`)
      }
    };
  }

  // --- 4. THE VIEW (Compact Specific) ---
  function updateView(state) {
    const el = {
      pill: $('.iss-pill'),
      text: $('.iss-text'),
      icon: $('.iss-icon')
    };

    if (!state || !state.isValid) {
      el.text.textContent = "—";
      return;
    }

    // A. Map Update
    const center = map.project([state.map.lat, state.map.lon], 2);
    map.setView(map.unproject([center.x, center.y], 2), 2, {animate: false});

    // B. Icon Update
    if (el.icon.src !== state.icon.url) el.icon.src = state.icon.url;
    el.icon.parentElement.style.transform = state.icon.rotation
      ? `translate(-50%, -50%) rotate(${state.icon.rotation}deg)`
      : `translate(-50%, -50%)`;

    // C. Pill Logic
    el.text.textContent = state.pill.text;
    applyMode(el.pill, el.text, state.pill.mode);

    if (state.pill.mode === 'EVENT') {
      fitTextToContainer(el.text, el.pill, 10, 16, true);
    } else {
      fitTextToContainer(el.text, el.pill, 12, 18, false);
    }
  }

  // --- 5. HELPERS ---
  // The framework has no text-fitting utility, so the binary search stays. It
  // sets an inline font-size, which outranks the value--* class above.
  function fitTextToContainer(node, wrap, minPx, maxPx, allowWrap){
    if(!node || !wrap) return;
    node.style.fontSize = maxPx + 'px';
    let lo=minPx, hi=maxPx, best=minPx;
    while (lo <= hi){
      const mid = (lo+hi)>>1;
      node.style.fontSize = mid + 'px';
      let fits = false;
      if (allowWrap) {
         fits = node.scrollHeight <= (wrap.clientHeight + 4);
      } else {
         fits = node.scrollWidth <= (wrap.clientWidth - 4);
      }
      if (fits){ best = mid; lo = mid + 1; } else { hi = mid - 1; }
    }
    node.style.fontSize = best + 'px';
  }

  // --- 6. BOOT ---
  // Leaflet is handed the element, not an id string.
  const map = L.map($('.iss-map'), {
    attributionControl:false, zoomControl:false, scrollWheelZoom:false,
    doubleClickZoom:false, boxZoom:false, keyboard:false, dragging:false,
    worldCopyJump:true, fadeAnimation:false, zoomAnimation:false, updateWhenIdle:true
  }).setView([0,0], 2);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key=cb1_2782_1_716df946c45899d9c31c5bb4', {
    subdomains:'abcd', maxZoom:10, minZoom:2, detectRetina:false, keepBuffer:0,
    reuseTiles:true, updateWhenIdle:true, className:'image-dither'
  }).addTo(map);

  setTimeout(() => map.invalidateSize(false), 60);

  updateView(computeState(RAW_DATA, CONFIG));
})();
</script>

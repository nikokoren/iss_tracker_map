{%- comment -%}
  shared.liquid — included by every view.

  This is the only file that should carry a <style> block. Everything in it is
  scoped under .iss, which is the class the view templates put on their
  outermost element.

  THE ONE RULE
  ------------
  A mashup renders every plugin into one document. There is no iframe and no
  shadow root, so this <style> block is a document-wide stylesheet. Anything
  not prefixed with .iss will be applied to whatever plugin is sitting next to
  us on the screen.

  Run `npm run lint` before committing. It fails the build on any selector
  that can reach outside .iss.
{%- endcomment -%}

<style>
  /* Custom properties live on .iss, never on :root. Declared here they are
     inherited by everything inside this plugin and by nothing outside it. */
  .iss {
    --iss-map-ratio: 2.4;
    --iss-dot-size: 9px;
    --iss-fact-gap: 6px;
  }

  /* Framework classes are only ever addressed as descendants of .iss. Writing
     `.layout { ... }` here would restyle all four quadrants of a mashup. */
  .iss .layout {
    gap: var(--iss-fact-gap);
  }

  .iss .iss-map {
    position: relative;
    width: 100%;
    aspect-ratio: var(--iss-map-ratio);
    overflow: hidden;
  }

  .iss .iss-map__station {
    position: absolute;
    width: var(--iss-dot-size);
    height: var(--iss-dot-size);
    /* Positioned from inline style on the element itself, because the
       coordinates come from Liquid and change every refresh. */
  }

  .iss .iss-facts {
    display: flex;
    justify-content: space-between;
    gap: var(--iss-fact-gap);
  }

  /* Animation names are global. Prefixing avoids a collision with another
     plugin that also wanted to call something "pulse". */
  @keyframes iss-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }
</style>

{%- comment -%}
  quadrant.liquid — ISS Tracker Map (compact view, native pill draft)

  Built from TRMNL Framework 3.4 classes only: no <style> block, no own fonts
  or sizes (CLAUDE.md, design rule). The script sets text, toggles framework
  classes (hidden, inverse, bg--white), builds the map, and places the
  station icon. The compact views show the place name or the event, never the
  KPIs.

  SCOPING CONTRACT: every DOM lookup goes through ROOT, this instance's own
  subtree, never through document. Run `npm run lint` before publishing.

  Identical in content to half_vertical.liquid. Change both together.
{%- endcomment -%}

<div class="layout iss">
 <div class="relative w--full h--full">
  <div class="iss-map map"></div>
  <div class="iss-craft absolute z--1"><img class="iss-icon w--12 h--12" alt="ISS" src="" /></div>

  <div class="iss-pill absolute bottom--4 left--2 right--2 z--2 bg--white outline rounded--medium p--2">
   <div class="flex flex--col flex--center-x">
    <span class="iss-name title md:portrait:title--small lg:title--large lg:portrait:title--large text--bold text--center" data-value-fit="true">Loading...</span>
    <span class="iss-event title title--small lg:title--base text--bold hidden">—</span>
   </div>
  </div>
 </div>
</div>
<link rel="stylesheet" href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css">
<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<script>
(() => {
  // --- 0. THIS INSTANCE'S ROOT ---
  // Every lookup goes through ROOT. In a mashup document.querySelector
  // returns whichever plugin comes first in the DOM.
  const SELF = document.currentScript;
  const ROOT =
    (SELF && SELF.closest('.iss')) ||
    (SELF && SELF.parentElement && SELF.parentElement.querySelector('.iss')) ||
    document.querySelector('.iss');
  if (!ROOT) return;
  const $ = (sel) => ROOT.querySelector(sel);

  // --- 1. CONSTANTS & CONFIG ---
  const CONFIG = {
    enableRotation: "{{ trmnl.plugin_settings.custom_fields_values.random_rotation | default: 'true' }}" !== 'false',
    urls: {
      iss: "https://raw.githubusercontent.com/nikokoren/mission_control/refs/heads/main/rockets/iss.png",
      eva: "https://raw.githubusercontent.com/nikokoren/mission_control/refs/heads/main/rockets/iss_eva.png"
    }
  };

  // --- 2. INPUT DATA (Raw) ---
  const firstNonEmpty = (...xs) => { for (const x of xs){ const s=String(x??'').trim(); if(s) return s; } return ''; };
  const RAW_DATA = {
    lat: firstNonEmpty('{{ lat }}', '{{ IDX_0.lat }}'),
    lon: firstNonEmpty('{{ lon }}', '{{ IDX_0.lon }}'),
    place: firstNonEmpty('{{ place }}', '{{ IDX_0.place }}'),
    short_info: '{% if trmnl.plugin_settings.custom_fields_values.show_iss_events == "true" %}{{ special_event.short_info | default: "" }}{% endif %}',
    event_type: '{{ special_event.type | default: "" }}'
  };

  // --- 3. THE BRAIN (Shared Logic) ---
  function computeState(raw, cfg) {
    const lat = Number(raw.lat);
    const lon = Number(raw.lon);
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;

    const info = raw.short_info.trim();
    const hasActiveEvent = info.length > 0;
    const isEVA = raw.event_type.trim() === "EVA" && hasActiveEvent;

    return {
      isValid: true,
      map: { lat, lon },
      icon: {
        url: isEVA ? cfg.urls.eva : cfg.urls.iss,
        rotation: cfg.enableRotation ? Math.floor(Math.random() * 360) : 0
      },
      pill: {
        mode: hasActiveEvent ? 'EVENT' : 'LOCATION',
        text: hasActiveEvent ? info : ((raw.place || '').trim() || `${lat.toFixed(2)}°, ${lon.toFixed(2)}°`)
      }
    };
  }

  // --- 4. THE VIEW ---
  // Text and framework classes only. On the OG in portrait the name stays
  // title--small: a long name in the wider title font did not fit even at Fit
  // Value's 8px there; the lg: classes keep the X's size in both orientations.
  // The place name is fitted by the
  // framework (data-value-fit). It is a centred item of a flex column, so its
  // box is as wide as its text: Fit Value compares the element's own box with
  // its parent's. An event replaces the name: its text wraps, the
  // pill grows with it and is inverted (bg--white and inverse swapped, not
  // combined: with both, a 1-bit screen drew black text on the black pill).
  function updateView(state) {
    const el = {
      pill: $('.iss-pill'),
      name: $('.iss-name'),
      event: $('.iss-event'),
      icon: $('.iss-icon')
    };

    if (!state || !state.isValid) {
      el.name.textContent = "—";
      return;
    }

    if (el.icon.src !== state.icon.url) el.icon.src = state.icon.url;
    el.icon.style.transform = state.icon.rotation ? `rotate(${state.icon.rotation}deg)` : '';

    const isEvent = state.pill.mode === 'EVENT';
    el.pill.classList.toggle('inverse', isEvent);
    el.pill.classList.toggle('bg--white', !isEvent);
    el.name.classList.toggle('hidden', isEvent);
    el.event.classList.toggle('hidden', !isEvent);
    // Event text in capitals, as in v1.3: the framework has no uppercase
    // class, so the text itself is converted (owner's OK, 2026-10-21, CLAUDE.md).
    if (isEvent) el.event.textContent = state.pill.text.toUpperCase();
    else { el.name.textContent = state.pill.text; setNameFit(el.name); }
  }

  // On the X the place name may take two lines before it shrinks: Fit Value
  // with a maximum height (data-value-fit-max-height) wraps the name and
  // shrinks it only if two lines are not enough. That height is a number of
  // pixels and the title's line height differs per screen, so it is written
  // here: twice the title's own line height, read with any size the framework
  // set before put aside. On the OG the attribute is left out: one line, as
  // the owner approved it there. Returns whether it changed.
  function setNameFit(name){
    if (!name) return false;
    const screen = ROOT.closest('.screen');
    if (!(screen && screen.classList.contains('screen--lg'))) {
      if (!name.hasAttribute('data-value-fit-max-height')) return false;
      name.removeAttribute('data-value-fit-max-height');
      return true;
    }
    const saved = [name.style.fontSize, name.style.lineHeight, name.style.fontWeight, name.style.fontVariationSettings];
    name.style.fontSize = name.style.lineHeight = name.style.fontWeight = name.style.fontVariationSettings = '';
    const lh = parseFloat(getComputedStyle(name).lineHeight) || 0;
    [name.style.fontSize, name.style.lineHeight, name.style.fontWeight, name.style.fontVariationSettings] = saved;
    if (!lh) return false;
    const max = String(Math.round(2 * lh));
    if (name.getAttribute('data-value-fit-max-height') === max) return false;
    name.setAttribute('data-value-fit-max-height', max);
    return true;
  }

  // --- 5. MAP ---
  // TRMNL's own map (TRMNLMaps on MapLibre): the framework draws and dithers
  // it for each panel's bit depth and writes the OpenStreetMap credit into it.
  // watch() is given the element, not an id, so two instances in one mashup
  // don't collide; it rebuilds the map when the device, scale or mode changes.
  // Zoom 1 shows what Leaflet's zoom 2 did (512px tiles against 256px); whole
  // numbers only, as the framework dithers only at an integer zoom.
  // The map waits until MapLibre and the framework are loaded and the map has
  // a size, checking every 50 ms for up to 10 s, as Downstream does. A host
  // can run this script before either has loaded (markup inserted with its
  // <script src> tags re-created loads them after this one; the map then
  // stayed empty), and TRMNL's preview sets the screen's size classes after
  // load.
  function whenReady(cb){
    let tries = 0;
    (function attempt(){
      const el = $('.iss-map');
      if (typeof TRMNLMaps !== 'undefined' && typeof maplibregl !== 'undefined' &&
          el && el.clientWidth && el.clientHeight) return cb();
      if (++tries <= 200) setTimeout(attempt, 50);
    })();
  }

  function buildMap(state){
    const el = $('.iss-map');
    if (!state || !el || typeof TRMNLMaps === 'undefined' || typeof maplibregl === 'undefined') return;
    TRMNLMaps.watch(el, () => {
      const opts = TRMNLMaps.options({ el, preset: 'outline', center: [state.map.lon, state.map.lat], zoom: 1 });
      // The station crosses the 180th meridian every orbit; without world
      // copies the far side of the line would be blank.
      opts.renderWorldCopies = true;
      const map = new maplibregl.Map(opts);
      el.__issMap = map; // read by tools/render/render-check.mjs
      // The icon goes where the map draws the station, centred on it. Not the
      // map's centre: MapLibre shows nothing beyond the poles, so on a map
      // about as tall as the world it moves the centre toward the equator.
      // (Script placement: the framework has no way to put custom art on a
      // map. OK'd by the owner 2026-10-22, CLAUDE.md.)
      const craft = $('.iss-craft');
      const placeCraft = () => {
        const p = map.project([state.map.lon, state.map.lat]);
        craft.style.left = (el.offsetLeft + p.x - craft.offsetWidth / 2) + 'px';
        craft.style.top = (el.offsetTop + p.y - craft.offsetHeight / 2) + 'px';
      };
      map.on('load', placeCraft);
      map.on('moveend', placeCraft);
      return map;
    });
  }

  // --- 6. BOOT ---
  const state = computeState(RAW_DATA, CONFIG);
  updateView(state);
  whenReady(() => buildMap(state));

  // A new size class can change the title's line height: refit if so.
  const screenEl = ROOT.closest('.screen');
  if (screenEl && typeof MutationObserver !== 'undefined') {
    new MutationObserver(() => {
      if (setNameFit($('.iss-name')) && typeof window.terminalize === 'function') window.terminalize();
    }).observe(screenEl, { attributes: true, attributeFilter: ['class'] });
  }

  // When the plugin's size changes after load (TRMNL's preview lays it out
  // late), the framework is asked to run its pass again (window.terminalize,
  // its public API), so Fit Value fits the place name to the real width; the
  // framework itself re-runs only on screen class changes.
  if (typeof ResizeObserver !== 'undefined') {
    let w = -1, h = -1;
    new ResizeObserver(() => {
      if (ROOT.offsetWidth === w && ROOT.offsetHeight === h) return;
      const first = w < 0;
      w = ROOT.offsetWidth; h = ROOT.offsetHeight;
      if (!first && typeof window.terminalize === 'function') window.terminalize();
    }).observe(ROOT);
  }
})();
</script>
